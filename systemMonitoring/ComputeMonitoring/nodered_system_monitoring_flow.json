[
    {
        "id": "system_monitor_flow",
        "type": "tab",
        "label": "System Monitoring",
        "disabled": false,
        "info": "Ingest system monitoring data from obsybox/system_monitoring topic"
    },
    {
        "id": "mqtt_in_system",
        "type": "mqtt in",
        "z": "system_monitor_flow",
        "name": "System Stats MQTT",
        "topic": "obsybox/system_monitoring",
        "qos": "1",
        "datatype": "json",
        "broker": "mqtt_broker_config",
        "nl": false,
        "rap": true,
        "rh": 0,
        "x": 150,
        "y": 100,
        "wires": [["parse_system_data"]]
    },
    {
        "id": "parse_system_data",
        "type": "function",
        "z": "system_monitor_flow",
        "name": "Parse System Data",
        "func": "// Parse the incoming system monitoring data\nconst data = msg.payload;\nconst timestamp = new Date().toISOString();\n\n// Add timestamp and format for different outputs\nmsg.influxdb = {\n    measurement: 'system_stats',\n    tags: {\n        hostname: data.hostname\n    },\n    fields: {\n        cpu_load: data.cpu_load || null,\n        cpu_temp_c: data.cpu_temp_c || null,\n        disk_free_gb: data.disk_free_gb || null,\n        wifi_signal_percent: data.wifi_signal_percent || null,\n        wifi_signal_dbm: data.wifi_signal_dbm || null\n    },\n    timestamp: timestamp\n};\n\n// Format for debug/dashboard\nmsg.dashboard = {\n    hostname: data.hostname,\n    cpu_load: data.cpu_load,\n    cpu_temp: data.cpu_temp_c,\n    disk_free: data.disk_free_gb,\n    wifi_signal: data.wifi_signal_percent,\n    wifi_dbm: data.wifi_signal_dbm,\n    last_update: timestamp\n};\n\n// Keep original payload\nmsg.original = data;\n\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 370,
        "y": 100,
        "wires": [["debug_output", "influxdb_output", "dashboard_output"]]
    },
    {
        "id": "debug_output",
        "type": "debug",
        "z": "system_monitor_flow",
        "name": "System Stats Debug",
        "active": true,
        "tosidebar": true,
        "console": false,
        "tostatus": false,
        "complete": "dashboard",
        "targetType": "msg",
        "statusVal": "",
        "statusType": "auto",
        "x": 620,
        "y": 60,
        "wires": []
    },
    {
        "id": "influxdb_output",
        "type": "influxdb out",
        "z": "system_monitor_flow",
        "influxdb": "influxdb_config",
        "name": "Store in InfluxDB",
        "measurement": "system_stats",
        "precision": "",
        "retentionPolicy": "",
        "database": "obsybox",
        "precisionV18FluxV20": "ms",
        "retentionPolicyV18Flux": "",
        "org": "obsybox",
        "bucket": "system_monitoring",
        "x": 620,
        "y": 100,
        "wires": []
    },
    {
        "id": "dashboard_output",
